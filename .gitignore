# Entornos, cachés de Snakemake y Python
.snakemake/
__pycache__/
*.pyc
.DS_Store

# Binarios externos (GAMESS-US y GNINA)
bin/

# Bloquear por defecto artefactos intermedios y trayectorias pesadas en results/
results/*
!results/mcpb/
results/mcpb/*
!results/mcpb/SIRT6_Zn_mcpbpy.frcmod
!results/mcpb/ZN1.mol2
!results/mcpb/CM*.mol2

!results/clustering/
results/clustering/*
!results/clustering/cluster_summary.dat
!results/clustering/pocket_box.txt

!results/docking/
results/docking/*
!results/docking/ensemble_detailed.csv
!results/docking/ensemble_summary.csv
!results/docking/poses/
results/docking/poses/*.log

!results/holo_mdl800/
